generator client {
  provider = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String?   // null for Google-only accounts
  googleId  String?   @unique // Google OAuth ID
  passwordResetToken   String?   // hashed reset token
  passwordResetExpires DateTime? // token expiry
  tokenVersion Int @default(0) // raised to cancel every token issued before
  phone     String?   @default("")
  avatar    String?   @default("")
  addresses Address[]
  orders    Order[]
  favorites Favorite[]
  reviews   Review[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  role Role @default(USER)
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  city      String
  state     String
  zip       String
  isDefault Boolean  @default(false)
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
}

model Product {
  id            String   @id @default(uuid())
  name          String
  description   String?  @default("")
  price         Float
  originalPrice Float?   @default(0)
  image         String
  category      String
  // A product must belong to an existing category. A category with products cannot be deleted
  categoryRef   Category @relation(fields: [category], references: [name], onDelete: Restrict, onUpdate: Cascade)
  favorites     Favorite[]
  reviews       Review[]
  stock         Int?     @default(0)
  rating        Float?   @default(0)
  reviewCount   Int?     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([category])
}

model Order {
  id              String @id @default(uuid())
  userId          String
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           Json
  shippingAddress Json
  paymentMethod   String @default("card")
  subtotal        Float
  deliveryFee     Float? @default(0)
  tax             Float? @default(0)
  total           Float
  status          String @default("Placed")
  statusHistory   Json

  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  deliveryOtp       String?          @default("")
  liveLocation      Json?
  isPaid            Boolean?         @default(false)
  paymentIntentId String? // Stripe payment, saved by the webhook: it is needed to refund
  refundId        String? // Stripe refund
  refundStatus    String? // "refunded" | "pending" | "failed". null = no refund involved
  discount        Float   @default(0) // what the coupon took off the items (subtotal is BEFORE it)
  couponId        String?
  coupon          Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode      String? // the code as it was when the order was placed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([deliveryPartnerId, status])
  @@index([createdAt])
    @@index([couponId])
}

model DeliveryPartner {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  phone       String
  avatar      String?  @default("")
  vehicleType String?  @default("bike")
  isActive    Boolean? @default(true)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Category {
  id        String    @id @default(uuid())
  name      String    @unique // also what every product stores in Product.category
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}


model Favorite {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // A user saves a product once: the pair IS the identity (no duplicates are possible)
  @@id([userId, productId])
  @@index([userId, createdAt])
}



enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id           String     @id @default(uuid())
  code         String     @unique // always saved in capitals ("WELCOME10")
  type         CouponType
  value        Float // PERCENT: above 0 and up to 100. FIXED: the dollars taken off
  maxDiscount  Float? // PERCENT only: the discount never goes above this
  minSubtotal  Float? // the items must cost at least this (before the discount)
  startsAt     DateTime?
  expiresAt    DateTime?
  usageLimit   Int? // across all customers. null = no limit
  perUserLimit Int? // for each customer. null = no limit
  isActive     Boolean    @default(true)
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}


model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1 to 5
  comment   String? // up to 1000 characters
  isHidden  Boolean  @default(false) // hidden by an admin: not shown and not counted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per customer per product: the pair is what makes it unique
  @@unique([userId, productId])
  @@index([productId, isHidden, createdAt])
  @@index([createdAt])
}