# ===== Server =====
PORT=5050
# On Vercel leave NODE_ENV alone: the platform sets it. The server behaves differently in production
# (Swagger off, errors hidden, CLIENT_URL required)
NODE_ENV=development
# The frontend address (used in emails) and the origins allowed to call this API (comma separated)
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Swagger is always on in development. In production leave this unset (or false) so the API shape is not public
ENABLE_SWAGGER=true

# ===== Database (Neon / PostgreSQL) =====
DATABASE_URL=

# ===== Auth =====
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ===== Google sign-in =====
# The OAuth Client ID (not the secret). The server does not start without it.
# The frontend uses the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# ===== Cloudinary (image uploads) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecommerce

# ===== Mail (Brevo SMTP) =====
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# ===== Stripe =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Inngest =====
# Local development ONLY: INNGEST_DEV=1, and run `npx inngest-cli@latest dev -u http://localhost:5050/api/inngest`
# NEVER set INNGEST_DEV in production: without it the SDK runs in cloud mode and needs both keys below
INNGEST_DEV=1
# Production: keys from the Inngest dashboard
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ===== Shared rate limit (Upstash) =====
# Optional in development, recommended in production (Upstash console: your database, REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Error tracking (Sentry) =====
# Optional: without it Sentry stays off
SENTRY_DSN=

# ===== Seed (local only) =====
# `npm run seed` DELETES EVERY PRODUCT: it refuses to run unless this is true
ALLOW_SEED=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Store Admin