# ===== Server =====
PORT=5050
NODE_ENV=development
# Frontend url (used in emails) and the origins allowed to call this API (comma separated)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Swagger is always on in development; set to true to also enable it in production
ENABLE_SWAGGER=true

# ===== Database (Neon / PostgreSQL) =====
DATABASE_URL=

# ===== Auth =====
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ===== Cloudinary (image uploads) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecommerce

# ===== Mail (Brevo SMTP) =====
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# ===== Stripe =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Inngest =====
# Local development: INNGEST_DEV=1 and run `npx inngest-cli@latest dev -u http://localhost:5050/api/inngest`
INNGEST_DEV=1
# Production: keys from the Inngest dashboard
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ===== Seed (local only) =====
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Store Admin



# Shared rate limit. Optional in development, recommended in production (Upstash console: your database, REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=