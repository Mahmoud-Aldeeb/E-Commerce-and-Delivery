# Backend origin only: no trailing slash and no /api (the app adds it)
# Read by the browser. NEXT_PUBLIC_* values are baked into the build:
# change it on Vercel, then redeploy
NEXT_PUBLIC_API_URL=http://localhost:5050
# Read by Server Components (optional: falls back to NEXT_PUBLIC_API_URL)
API_URL=http://localhost:5050

NEXT_PUBLIC_SITE_URL=http://localhost:3000