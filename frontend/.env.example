# The backend address, with no /api and no slash at the end
NEXT_PUBLIC_API_URL=http://localhost:5050
# Optional, server only: when the server reaches the API by another address than the browser does
API_URL=
# The public address of this web app (sitemap, robots, link previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The Google OAuth Client ID (the same value as GOOGLE_CLIENT_ID in the backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=